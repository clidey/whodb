enum SourceCategory {
  Database
  Cache
  Search
  ObjectStore
  FileStore
}

enum SourceModel {
  Relational
  Document
  KeyValue
  Search
  Graph
  Object
}

enum SourceSurface {
  Browser
  Query
  Graph
  Chat
}

enum SourceObjectKind {
  Database
  Schema
  Table
  View
  Collection
  Index
  Key
  Item
  Function
  Procedure
  Trigger
  Sequence
}

enum SourceAction {
  Browse
  Inspect
  ViewRows
  ViewContent
  ViewDefinition
  CreateChild
  Delete
  InsertData
  UpdateData
  DeleteData
  ImportData
  GenerateMockData
  Execute
  ViewGraph
}

enum SourceView {
  Grid
  JSON
  Text
  SQL
  Binary
  Metadata
  Graph
}

enum DataShape {
  Tabular
  Document
  Content
  Graph
  Metadata
}

enum SourceConnectionFieldKind {
  Text
  Password
  Boolean
  FilePath
}

enum SourceConnectionFieldSection {
  Primary
  Advanced
}

enum SourceConnectionTransport {
  Network
  File
  Bridge
}

enum SourceHostInputMode {
  None
  Hostname
  HostnameOrURL
}

enum SourceHostInputURLParser {
  None
  Postgres
  MongoSRV
}

enum SourceProfileLabelStrategy {
  Default
  Hostname
  Database
}

enum SourceSchemaFidelity {
  Exact
  Sampled
}

enum SourceMetadataFidelity {
  Exact
  Driver
  Sampled
  Inferred
  Synthetic
  Unsupported
  Unknown
}

enum SourceQueryExplainMode {
  None
  Explain
  ExplainAnalyze
  ExplainPipeline
}

scalar Upload

enum ImportFileFormat {
  CSV
  EXCEL
}

enum ImportMode {
  APPEND
  OVERWRITE
  UPSERT
}

type Column {
  Type: String!
  Name: String!
  MetadataFidelity: SourceMetadataFidelity!
  IsPrimary: Boolean!
  IsForeignKey: Boolean!
  ReferencedTable: String
  ReferencedColumn: String
  Length: Int
  Precision: Int
  Scale: Int
}

type SourceFieldConstraints {
  Name: String!
  Type: String!
  MetadataFidelity: SourceMetadataFidelity!
  Nullable: Boolean
  Primary: Boolean!
  Unique: Boolean!
  Identity: Boolean!
  DefaultValue: String
  AllowedValues: [String!]!
  CheckMin: Float
  CheckMax: Float
  ForeignKey: ForeignKeyDefinition
  Length: Int
  Precision: Int
  Scale: Int
}

type ForeignKeyDefinition {
  Table: String!
  Column: String!
}

type StorageUnitColumns {
    StorageUnit: String!
    Columns: [Column!]!
}

enum WhereConditionType {
  Atomic
  And
  Or
}

input AtomicWhereCondition {
  ColumnType: String!
  Key: String!
  Operator: String!
  Value: String!
}

input OperationWhereCondition {
  Children: [WhereCondition!]!
}

input WhereCondition {
  Type: WhereConditionType!
  Atomic: AtomicWhereCondition
  And: OperationWhereCondition
  Or: OperationWhereCondition
}

enum SortDirection {
  ASC
  DESC
}

input SortCondition {
  Column: String!
  Direction: SortDirection!
}

type RowsResult {
  Columns: [Column!]!
  Rows: [[String!]!]!
  DisableUpdate: Boolean!
    TotalCount: Int!
}

type SourceContent {
  Text: String
  MIMEType: String!
  IsBinary: Boolean!
  SizeBytes: String!
  Truncated: Boolean!
  FileName: String!
  ModifiedAt: String
}

type Record {
  Key: String!
  Value: String!
}

input RecordInput {
  Key: String!
  Value: String!
  Extra: [RecordInput!]
}

type ObjectCreationMetadata {
  Supported: Boolean!
  ObjectKind: SourceObjectKind!
  RequiresColumns: Boolean!
  TypeDefinitions: [TypeDefinition!]!
  ColumnCapabilities: ColumnCreationCapabilities!
  ColumnLabels: ColumnCreationLabels!
  TableCapabilities: TableCreationCapabilities!
  TableOptions: [CreationOptionDefinition!]!
}

type ColumnCreationCapabilities {
  Types: Boolean!
  Nullable: Boolean!
  PrimaryKey: Boolean!
  CompositePrimaryKey: Boolean!
  Unique: Boolean!
  Identity: Boolean!
  DefaultValue: Boolean!
  CheckValues: Boolean!
  CheckMinMax: Boolean!
  ForeignKey: Boolean!
}

type ColumnCreationLabels {
  Nullable: String!
  PrimaryKey: String!
  Unique: String!
  Identity: String!
  DefaultValue: String!
  CheckValues: String!
  CheckMin: String!
  CheckMax: String!
  ForeignKey: String!
}

type TableCreationCapabilities {
  RequiresPrimaryKey: Boolean!
  PartitionKey: Boolean!
  ClusteringKey: Boolean!
  OrderKey: Boolean!
  KeyValueType: Boolean!
}

type CreationOptionDefinition {
  Key: String!
  Label: String!
  Required: Boolean!
  Values: [String!]!
}

input SourceObjectDefinitionInput {
  Name: String!
  Columns: [ColumnDefinitionInput!]!
  TableOptions: [RecordInput!]
}

input ColumnDefinitionInput {
  Name: String!
  Type: String!
  Nullable: Boolean
  Primary: Boolean!
  Unique: Boolean!
  Identity: Boolean!
  DefaultValue: String
  CheckValues: [String!]
  CheckMin: Float
  CheckMax: Float
  ForeignKey: ForeignKeyDefinitionInput
}

input ForeignKeyDefinitionInput {
  Table: String!
  Column: String!
}

input ImportFileOptions {
  Format: ImportFileFormat!
  Delimiter: String
  Sheet: String
}

input ImportColumnMapping {
  SourceColumn: String!
  TargetColumn: String
  Skip: Boolean!
}

input ImportFileInput {
  Ref: SourceObjectRefInput!
  Mode: ImportMode!
  Options: ImportFileOptions!
  File: Upload!
  Mapping: [ImportColumnMapping!]!
  AllowAutoGenerated: Boolean
}

input ImportSQLInput {
  Script: String
  File: Upload
  Filename: String
}

enum GraphUnitRelationshipType {
  OneToOne,
  OneToMany,
  ManyToOne,
  ManyToMany,
  Unknown,
}

type GraphUnitRelationship {
  Name: String!
  Relationship: GraphUnitRelationshipType!
  MetadataFidelity: SourceMetadataFidelity!
  SourceColumn: String
  TargetColumn: String
}

type GraphUnit {
  Unit: SourceObject!
	Relations: [GraphUnitRelationship!]!
}

type SettingsConfig {
  MetricsEnabled: Boolean
  DisableCredentialForm: Boolean!
  EnableNewUI: Boolean!
  MaxPageSize: Int!
}

input SettingsConfigInput {
  MetricsEnabled: String
}

input SourceLoginInput {
  Id: String
  SourceType: String!
  Values: [RecordInput!]!
  AccessToken: String
}

input SourceProfileLoginInput {
  Id: String!
  Values: [RecordInput!]
}

type SourceProfile {
  Id: String!
  DisplayName: String!
  SourceType: String!
  Values: [Record!]!
  IsEnvironmentDefined: Boolean!
  Source: String!
  SSLConfigured: Boolean!
}

type StatusResponse {
  Status: Boolean!
}

type ImportPreview {
  Sheet: String
  Columns: [String!]!
  Rows: [[String!]!]!
  Truncated: Boolean!
  ValidationError: String
  Mapping: [ImportColumnMappingPreview!]
  RequiresAllowAutoGenerated: Boolean!
  AutoGeneratedColumns: [String!]!
}

type ImportColumnMappingPreview {
  SourceColumn: String!
  TargetColumn: String!
}

type ImportResult {
  Status: Boolean!
  Message: String!
  Detail: String
}

input MockDataGenerationInput {
  Ref: SourceObjectRefInput!
  RowCount: Int!
  Method: String!
  OverwriteExisting: Boolean!
  FkDensityRatio: Int
}

type MockDataTableInfo {
  Table: String!
  RowsToGenerate: Int!
  IsBlocked: Boolean!
  UsesExistingData: Boolean!
}

type MockDataTableDetail {
  Table: String!
  RowsGenerated: Int!
  UsedExistingData: Boolean!
}

type MockDataDependencyAnalysis {
  GenerationOrder: [String!]!
  Tables: [MockDataTableInfo!]!
  TotalRows: Int!
  Warnings: [String!]!
  Error: String
}

type MockDataGenerationStatus {
  AmountGenerated: Int!
  Details: [MockDataTableDetail!]
}

input ChatInput {
  PreviousConversation: String!
  Query: String!
  Model: String!
  Token: String
}

type AIChatMessage {
  Type: String!
  Result: RowsResult
  Text: String!
  RequiresConfirmation: Boolean!
}

type AIProvider {
  Type: String!
  Name: String!
  ProviderId: String!
  IsEnvironmentDefined: Boolean!
  IsGeneric: Boolean!
  Icon: String
}

enum TypeCategory {
  numeric
  text
  binary
  datetime
  boolean
  json
  other
}

type TypeDefinition {
  id: String!
  label: String!
  hasLength: Boolean!
  hasPrecision: Boolean!
  defaultLength: Int
  defaultPrecision: Int
  category: TypeCategory!
  insertFunc: String
  tableModel: String
}

type SourceConnectionField {
  Key: String!
  Kind: SourceConnectionFieldKind!
  Section: SourceConnectionFieldSection!
  Required: Boolean!
  LabelKey: String!
  PlaceholderKey: String
  DefaultValue: String
  SupportsOptions: Boolean!
}

type SourceObjectType {
  Kind: SourceObjectKind!
  DataShape: DataShape!
  Actions: [SourceAction!]!
  Views: [SourceView!]!
  SingularLabel: String!
  PluralLabel: String!
}

type SourceContract {
  Model: SourceModel!
  Surfaces: [SourceSurface!]!
  RootActions: [SourceAction!]!
  BrowsePath: [SourceObjectKind!]!
  DefaultObjectKind: SourceObjectKind!
  GraphScopeKind: SourceObjectKind
  ObjectTypes: [SourceObjectType!]!
}

type SourceConnectionTraits {
  Transport: SourceConnectionTransport!
  HostInputMode: SourceHostInputMode!
  HostInputURLParser: SourceHostInputURLParser!
  SupportsCustomCAContent: Boolean!
}

type SourcePresentationTraits {
  ProfileLabelStrategy: SourceProfileLabelStrategy!
  SchemaFidelity: SourceSchemaFidelity!
}

type SourceQueryTraits {
  SupportsAnalyze: Boolean!
  SupportsScripts: Boolean!
  SupportsStreaming: Boolean!
  SupportsMultiStatement: Boolean!
  SupportsSqlImport: Boolean!
  ExplainMode: SourceQueryExplainMode!
  SequentialPaginationOnly: Boolean!
}

type SourceMockDataTraits {
  SupportsRelationalDependencies: Boolean!
}

type SourceMetadataTraits {
  Columns: SourceMetadataFidelity!
  Constraints: SourceMetadataFidelity!
  Graph: SourceMetadataFidelity!
  SystemObjectFiltering: SourceMetadataFidelity!
}

type SourceTraits {
  Connection: SourceConnectionTraits!
  Presentation: SourcePresentationTraits!
  Query: SourceQueryTraits!
  MockData: SourceMockDataTraits!
  Metadata: SourceMetadataTraits!
}

type SourceType {
  Id: String!
  Label: String!
  Connector: String!
  Category: SourceCategory!
  Traits: SourceTraits!
  ConnectionFields: [SourceConnectionField!]!
  Contract: SourceContract!
  DiscoveryPrefill: SourceDiscoveryPrefill!
  IsAWSManaged: Boolean!
  SSLModes: [SourceSSLMode!]!
}

type SourceSSLMode {
  value: String!
  aliases: [String!]!
}

type SourceDiscoveryMetadataCondition {
  Key: String!
  Value: String!
}

type SourceDiscoveryAdvancedDefault {
  Key: String!
  Value: String!
  MetadataKey: String!
  DefaultValue: String!
  ProviderTypes: [String!]!
  Conditions: [SourceDiscoveryMetadataCondition!]!
}

type SourceDiscoveryPrefill {
  AdvancedDefaults: [SourceDiscoveryAdvancedDefault!]!
}

type SourceObjectRef {
  Kind: SourceObjectKind!
  Locator: String!
  Path: [String!]!
}

input SourceObjectRefInput {
  Kind: SourceObjectKind!
  Locator: String
  Path: [String!]!
}

type SourceObject {
  Ref: SourceObjectRef!
  Kind: SourceObjectKind!
  Name: String!
  Path: [String!]!
  HasChildren: Boolean!
  Actions: [SourceAction!]!
  Metadata: [Record!]!
}

type SourceObjectColumns {
  Ref: SourceObjectRef!
  Columns: [Column!]!
}

type SourceSessionMetadata {
  SourceType: String!
  QueryLanguages: [String!]!
  TypeDefinitions: [TypeDefinition!]!
  Operators: [String!]!
  AliasMap: [Record!]!
}

# Safe UI state for the active source session. Credentials and connection
# details are excluded from normal session restoration.
type SourceSession {
  Id: String
  SourceType: String!
  Database: String!
}

type SourceQuerySuggestion {
  description: String!
  category: String!
}

# =============================================================================
# SSL/TLS Configuration Types
# =============================================================================

type SSLStatus {
  IsEnabled: Boolean!
  Mode: String!
}

# =============================================================================
# Queries
# =============================================================================

type UpdateInfo {
  currentVersion: String!
  latestVersion: String!
  updateAvailable: Boolean!
  releaseURL: String!
}

type HealthStatus {
  Server: String!
  Database: String!
}

type Query {
  Version: String!
  UpdateInfo: UpdateInfo!
  Health: HealthStatus!
  SourceProfiles: [SourceProfile!]!
  SourceTypes: [SourceType!]!
  SourceFieldOptions(sourceType: String!, fieldKey: String!, values: [RecordInput!]): [String!]!
  SourceSession: SourceSession
  SourceSessionMetadata: SourceSessionMetadata
  SourceObjectCreationMetadata(parent: SourceObjectRefInput): ObjectCreationMetadata!
  SourceObjects(parent: SourceObjectRefInput, kinds: [SourceObjectKind!]): [SourceObject!]!
  SourceObject(ref: SourceObjectRefInput!): SourceObject
  SourceRows(ref: SourceObjectRefInput!, where: WhereCondition, sort: [SortCondition!], pageSize: Int!, pageOffset: Int!): RowsResult!
  SourceContent(ref: SourceObjectRefInput!): SourceContent
  SourceColumns(ref: SourceObjectRefInput!): [Column!]!
  SourceColumnsBatch(refs: [SourceObjectRefInput!]!): [SourceObjectColumns!]!
  SourceFieldConstraints(ref: SourceObjectRefInput!): [SourceFieldConstraints!]!
  RunSourceQuery(query: String!): RowsResult!
  SourceGraph(ref: SourceObjectRefInput): [GraphUnit!]!
  AIProviders: [AIProvider!]!
  AIModel(providerId: String, modelType: String!, token: String): [String!]!
  SettingsConfig: SettingsConfig!
  MockDataMaxRowCount: Int!
  AnalyzeMockDataDependencies(ref: SourceObjectRefInput!, rowCount: Int!, fkDensityRatio: Int): MockDataDependencyAnalysis!
  SSLStatus: SSLStatus
  SourceQuerySuggestions(ref: SourceObjectRefInput): [SourceQuerySuggestion!]!

}

input GenerateChatTitleInput {
  Query: String!
  ModelType: String!
  ProviderId: String
  Token: String
  Model: String!
  Endpoint: String
  SessionId: String
}

type GenerateChatTitleResponse {
  Title: String!
}

type Mutation {
  LoginSource(credentials: SourceLoginInput!): StatusResponse!
  LoginWithSourceProfile(profile: SourceProfileLoginInput!): StatusResponse!
  Logout: StatusResponse!
  # Explicitly exports the authenticated connection; secrets require consent.
  ExportSourceConnection(id: String!, includeSecrets: Boolean!): [Record!]!
  TestSourceConnection(credentials: SourceLoginInput!): StatusResponse!
  UpdateSettings(newSettings: SettingsConfigInput!): StatusResponse!

  CreateSourceObject(parent: SourceObjectRefInput, name: String!, fields: [RecordInput!]!): StatusResponse!
  CreateSourceObjectFromDefinition(parent: SourceObjectRefInput, definition: SourceObjectDefinitionInput!): StatusResponse!
  UpdateSourceObject(ref: SourceObjectRefInput!, values: [RecordInput!]!, updatedColumns: [String!]!): StatusResponse!
  AddSourceRow(ref: SourceObjectRefInput!, values: [RecordInput!]!): StatusResponse!
  DeleteSourceRow(ref: SourceObjectRefInput!, values: [RecordInput!]!): StatusResponse!
  GenerateMockData(input: MockDataGenerationInput!): MockDataGenerationStatus!

  ImportSQL(input: ImportSQLInput!): ImportResult!
  ImportPreview(
    file: Upload!
    options: ImportFileOptions!
    ref: SourceObjectRefInput
    useHeaderMapping: Boolean
  ): ImportPreview!
  ImportSourceObjectFile(input: ImportFileInput!): ImportResult!

  # AI Chat Mutations
  ExecuteConfirmedSQL(query: String!, operationType: String!): AIChatMessage!
  GenerateChatTitle(input: GenerateChatTitleInput!): GenerateChatTitleResponse!

}
