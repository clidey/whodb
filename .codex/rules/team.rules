# Team rules (AGENTS.md), kept in sync across the clidey repositories; don't edit
# by hand. Agents never publish, push images, deploy (UAT or production) or touch
# production.

# Scripts that push images, publish, notarize, deploy or change a cluster.
REFUSED_SCRIPTS = ["./build.sh", "./ee/release/build.sh", "ee/release/build.sh"]

prefix_rule(pattern = [REFUSED_SCRIPTS], decision = "forbidden", justification = "This script pushes images, publishes, notarizes, deploys or changes a cluster; agents never run it (Team Rules in AGENTS.md). Hand the command to the user.")
prefix_rule(pattern = [["bash", "sh", "zsh"], REFUSED_SCRIPTS], decision = "forbidden", justification = "This script pushes images, publishes, notarizes, deploys or changes a cluster; agents never run it (Team Rules in AGENTS.md). Hand the command to the user.")

# Publishing, pushing images, deploying, notarizing, power settings, npm & co.
prefix_rule(pattern = ["docker", "push"], decision = "forbidden", justification = "Agents don't push images; build locally to test and hand the push to the user.")
prefix_rule(pattern = ["docker", "image", "push"], decision = "forbidden", justification = "Agents don't push images; build locally to test and hand the push to the user.")
prefix_rule(pattern = ["docker", "manifest", "push"], decision = "forbidden", justification = "Agents don't push images; hand the push to the user.")
prefix_rule(pattern = ["docker", "buildx", "imagetools", "create"], decision = "forbidden", justification = "This pushes a manifest; hand it to the user.")
prefix_rule(pattern = ["docker", "compose", "push"], decision = "forbidden", justification = "Agents don't push images; hand the push to the user.")
prefix_rule(pattern = ["podman", "push"], decision = "forbidden", justification = "Agents don't push images; hand the push to the user.")
prefix_rule(pattern = ["pnpm", "publish"], decision = "forbidden", justification = "Agents don't publish packages; hand the release to the user.")
prefix_rule(pattern = ["cargo", "publish"], decision = "forbidden", justification = "Agents don't publish packages; hand the release to the user.")
prefix_rule(pattern = ["uv", "publish"], decision = "forbidden", justification = "Agents don't publish packages; hand the release to the user.")
prefix_rule(pattern = ["twine", "upload"], decision = "forbidden", justification = "Agents don't publish packages; hand the release to the user.")
prefix_rule(pattern = ["gh", "release", "create"], decision = "forbidden", justification = "Agents don't publish releases; hand it to the user.")
prefix_rule(pattern = ["gh", "release", "upload"], decision = "forbidden", justification = "Agents don't publish releases; hand it to the user.")
prefix_rule(pattern = ["gh", "release", "edit"], decision = "forbidden", justification = "Agents don't publish releases; hand it to the user.")
prefix_rule(pattern = ["gh", "release", "delete"], decision = "forbidden", justification = "Agents don't change releases; hand it to the user.")
prefix_rule(pattern = ["xcrun", "notarytool", "submit"], decision = "forbidden", justification = "Notarizing is the user's; sign locally with SKIP_NOTARIZE=1.")
prefix_rule(pattern = ["helm", "upgrade"], decision = "forbidden", justification = "Agents don't deploy, to UAT or production; prepare the command and hand it to the user.")
prefix_rule(pattern = ["helm", "install"], decision = "forbidden", justification = "Agents don't deploy, to UAT or production; prepare the command and hand it to the user.")
prefix_rule(pattern = ["helm", "uninstall"], decision = "forbidden", justification = "Agents don't change clusters; prepare the command and hand it to the user.")
prefix_rule(pattern = ["helm", "rollback"], decision = "forbidden", justification = "Agents don't change clusters; prepare the command and hand it to the user.")
prefix_rule(pattern = ["helm", "test"], decision = "forbidden", justification = "This runs test pods in a cluster; hand it to the user.")
prefix_rule(pattern = ["npm"], decision = "forbidden", justification = "Use pnpm (pnpm install / add / exec / dlx / view), never npm.")
prefix_rule(pattern = ["npx"], decision = "forbidden", justification = "Use pnpm dlx or pnpm exec, never npx.")
prefix_rule(pattern = ["yarn"], decision = "forbidden", justification = "Use pnpm, never yarn.")
prefix_rule(pattern = ["bun"], decision = "forbidden", justification = "Use pnpm, never bun.")
prefix_rule(pattern = ["bunx"], decision = "forbidden", justification = "Use pnpm dlx, never bunx.")
prefix_rule(pattern = ["kubectl", ["apply", "create", "patch", "replace", "edit", "autoscale", "set", "label", "annotate", "taint", "cordon", "uncordon", "drain", "expose", "run", "proxy"]], decision = "forbidden", justification = "This kubectl command writes or deletes; show the user the exact command and wait for them to run it.")

# Read-only kubectl, helm and gcloud commands run. Commands that write: show the
# user the exact command and wait (AGENTS.md, Team Rules).
