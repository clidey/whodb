# Allowlist for cli/Dockerfile. Ignore everything by default, then allow
# back in only what this build actually COPYs, so new top-level folders
# never need to be added here to stay excluded.
*
!core/
!cli/

# Exclude dev/test artifacts within the allowed directories.
**/node_modules
**/.gocache
**/*.test
**/*.out
**/*.db
**/.DS_Store
**/.pi-lens
core/tmp
cli/build
cli/whodb
