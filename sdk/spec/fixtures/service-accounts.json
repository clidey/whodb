{
  "fixtures": [
    {
      "name": "serviceAccounts.list is scoped to the organization",
      "call": { "domain": "serviceAccounts", "handle": null, "method": "list", "args": [] },
      "transcript": [
        {
          "expectRequest": { "operation": "ServiceAccounts", "variables": { "orgId": "00000000-0000-0000-0000-000000000001" } },
          "response": { "data": { "ServiceAccounts": [ { "id": "sa-1", "name": "ci", "keys": [] } ] } }
        }
      ],
      "expectResult": [ { "id": "sa-1", "name": "ci", "keys": [] } ]
    },
    {
      "name": "serviceAccounts.create sends name and description",
      "call": { "domain": "serviceAccounts", "handle": null, "method": "create", "args": ["ci-deployer", "Deploys from CI"] },
      "transcript": [
        {
          "expectRequest": { "operation": "CreateServiceAccount", "variablesContain": { "orgId": "00000000-0000-0000-0000-000000000001", "name": "ci-deployer", "description": "Deploys from CI" } },
          "response": { "data": { "CreateServiceAccount": { "id": "sa-2", "name": "ci-deployer" } } }
        }
      ],
      "expectResult": { "id": "sa-2", "name": "ci-deployer" }
    },
    {
      "name": "serviceAccounts.createKey returns the raw key once",
      "call": { "domain": "serviceAccounts", "handle": null, "method": "createKey", "args": ["sa-2", "2027-01-01T00:00:00Z"] },
      "transcript": [
        {
          "expectRequest": { "operation": "CreateServiceAccountKey", "variablesContain": { "orgId": "00000000-0000-0000-0000-000000000001", "serviceAccountId": "sa-2", "expiresAt": "2027-01-01T00:00:00Z" } },
          "response": { "data": { "CreateServiceAccountKey": { "key": { "id": "key-1", "keyPrefix": "whodb_" }, "rawKey": "whodb_secret" } } }
        }
      ],
      "expectResult": { "key": { "id": "key-1", "keyPrefix": "whodb_" }, "rawKey": "whodb_secret" }
    },
    {
      "name": "serviceAccounts.revokeKey and delete return nothing",
      "call": { "domain": "serviceAccounts", "handle": null, "method": "revokeKey", "args": ["key-1"] },
      "transcript": [
        {
          "expectRequest": { "operation": "RevokeServiceAccountKey", "variables": { "orgId": "00000000-0000-0000-0000-000000000001", "keyId": "key-1" } },
          "response": { "data": { "RevokeServiceAccountKey": { "Status": true } } }
        }
      ],
      "expectResult": null
    },
    {
      "name": "serviceAccounts.delete targets the account id",
      "call": { "domain": "serviceAccounts", "handle": null, "method": "delete", "args": ["sa-2"] },
      "transcript": [
        {
          "expectRequest": { "operation": "DeleteServiceAccount", "variables": { "orgId": "00000000-0000-0000-0000-000000000001", "id": "sa-2" } },
          "response": { "data": { "DeleteServiceAccount": { "Status": true } } }
        }
      ],
      "expectResult": null
    },
    {
      "name": "serviceAccounts.create without a name is ValidationError",
      "call": { "domain": "serviceAccounts", "handle": null, "method": "create", "args": [""] },
      "transcript": [],
      "expectError": { "type": "ValidationError", "messageContains": "name" }
    }
  ]
}
