{
  "fixtures": [
    {
      "name": "capabilities address behavior by ontology ID",
      "call": { "domain": "ontology", "handle": "Order", "method": "capabilities", "args": ["order-1"] },
      "transcript": [
        {
          "expectRequest": { "operation": "OntologyEntities" },
