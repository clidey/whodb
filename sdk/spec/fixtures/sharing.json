      "transcript": [
        {
          "expectRequest": { "operation": "ShareOntology", "inputContains": { "projectId": "proj-1", "ontologyId": "ont-1", "visibility": "allowlist", "allowedProjectIds": ["proj-2"] } },
          "response": { "data": { "ShareOntology": { "id": "share-2", "ontologyId": "ont-1", "visibility": "allowlist" } } }
        }
      ],
      "expectResult": { "id": "share-2", "ontologyId": "ont-1", "visibility": "allowlist" }
    },
    {
      "name": "sharing.unshare returns nothing",
      "call": { "domain": "sharing", "handle": null, "method": "unshare", "args": ["ont-1"] },
      "transcript": [
        {
          "expectRequest": { "operation": "UnshareOntology", "variables": { "projectId": "proj-1", "ontologyId": "ont-1" } },
          "response": { "data": { "UnshareOntology": { "Status": true } } }
        }
      ],
      "expectResult": null
    },
    {
      "name": "sharing.createReference uses the project as consumer",
      "call": { "domain": "sharing", "handle": null, "method": "createReference", "args": ["proj-owner", "ont-1", "shared_customers"] },
      "transcript": [
        {
          "expectRequest": { "operation": "CreateOntologyReference", "inputContains": { "consumerProjectId": "proj-1", "ownerProjectId": "proj-owner", "ontologyId": "ont-1", "alias": "shared_customers" } },
          "response": { "data": { "CreateOntologyReference": { "id": "ref-1", "alias": "shared_customers", "status": "active" } } }
        }
      ],
      "expectResult": { "id": "ref-1", "alias": "shared_customers", "status": "active" }
    },
    {
      "name": "sharing.references and referenceImpact read by project and reference",
