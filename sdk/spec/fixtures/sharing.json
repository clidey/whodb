      "transcript": [
        {
          "expectRequest": { "operation": "OntologyReferenceImpact", "variables": { "referenceId": "ref-1" } },
          "response": { "data": { "OntologyReferenceImpact": { "referenceId": "ref-1", "dependentLinks": 0, "dependentApps": 1, "dependentFuncs": 0, "dependentXfms": 0, "dependentBehavs": 0 } } }
        }
      ],
      "expectResult": { "referenceId": "ref-1", "dependentLinks": 0, "dependentApps": 1, "dependentFuncs": 0, "dependentXfms": 0, "dependentBehavs": 0 }
