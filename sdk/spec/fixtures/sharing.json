{
  "fixtures": [
    {
      "name": "sharing.shared lists ontologies this project shares",
      "call": { "domain": "sharing", "handle": null, "method": "shared", "args": [] },
      "transcript": [
        {
          "expectRequest": { "operation": "SharedOntologies", "variables": { "projectId": "proj-1" } },
          "response": { "data": { "SharedOntologies": [ { "id": "share-1", "ontologyId": "ont-1", "visibility": "organization", "consumers": [] } ] } }
        }
      ],
      "expectResult": [ { "id": "share-1", "ontologyId": "ont-1", "visibility": "organization", "consumers": [] } ]
    },
    {
      "name": "sharing.discover uses the project as consumer",
      "call": { "domain": "sharing", "handle": null, "method": "discover", "args": [] },
      "transcript": [
        {
          "expectRequest": { "operation": "DiscoverSharedOntologies", "variables": { "consumerProjectId": "proj-1" } },
          "response": { "data": { "DiscoverSharedOntologies": [] } }
        }
      ],
      "expectResult": []
    },
    {
      "name": "sharing.share sends the share input",
